# Chép thành docker/.env rồi điền. KHÔNG commit file .env.
# Mật khẩu và secret chỉ dùng chữ và số (nằm trong URL kết nối DB): openssl rand -hex 24

# ---- Truy cập ----
# Domain trỏ về VPS. Để trống khi demo LAN: dùng chứng chỉ tự ký (firmware vẫn chấp nhận).
DOMAIN=
LETSENCRYPT_EMAIL=
PUBLIC_BASE_URL=https://localhost

# ---- Database (database_design 12) ----
DB_SUPERUSER_PASSWORD=
DB_MIGRATOR_PASSWORD=
DB_APP_PASSWORD=

# ---- Backend (backend_design 15.1) ----
JWT_SECRET=
# Phải khớp hằng số trong firmware (S1)
GATEWAY_SECRETS=super-secret-key
PROVISION_KEY=airquality2026
# Token cho xiaozhi-bridge gọi /api/v1/assistant; để trống thì tắt API trợ lý
ASSISTANT_TOKEN=
# Không bắt buộc: để trống thì tắt thẻ thời tiết / Telegram
WEATHER_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Xiaozhi (chỉ khi chạy --profile xiaozhi) ----
MCP_ENDPOINT=
